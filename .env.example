# Copy this file to .env. Do not commit your real credentials.
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
OLLAMA_MODEL=llama3
# For Ollama on the host Docker Desktop machine:
OLLAMA_URL=http://host.docker.internal:11434/api/generate
# Optional: uses Gemini for review notes and the conversational assistant.
# Leave blank to use Ollama, with an offline secure-coding fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
